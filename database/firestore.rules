rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Websites collection rules
    match /websites/{websiteId} {
      allow read: if true; // Allow public rendering of previews
      allow write: if isAuthenticated() && isOwner(resource.data.ownerUid);
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerUid);
    }

    // Pages collection rules
    match /pages/{pageId} {
      allow read: if true; // Publicly readable for rendering compiled websites
      allow write, create: if isAuthenticated();
    }

    // Media library rules
    match /media/{mediaId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.ownerUid);
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerUid);
    }

    // Form submissions rules
    match /submissions/{subId} {
      allow create: if true; // Public visitors can submit forms
      allow read, delete: if isAuthenticated();
    }

    // Activity log rules
    match /activity/{activityId} {
      allow create, read: if isAuthenticated() && isOwner(request.resource.data.ownerUid);
    }
    
    // User profile rules
    match /users/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
    }
  }
}
